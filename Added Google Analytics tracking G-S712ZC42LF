    <style>
        /* ===== CSS VARIABLES ===== */
        :root {
            --bg-body: #0b0d17;
            --text-main: #e8ecf4;
            --text-muted: #94a3b8;
            --primary: #6c63ff;
            --surface: rgba(20, 23, 43, 0.7);
            --border: #2a2f4f;
            --shadow-luxe: 0 20px 60px rgba(108, 99, 255, 0.3);
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            font-family: 'Inter', sans-serif; 
            background: var(--bg-body); 
            color: var(--text-main); 
            line-height: 1.7; 
            scroll-behavior: smooth;
        }
        
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        
        .glass { 
            background: var(--surface); 
            backdrop-filter: blur(12px); 
            border: 1px solid var(--border); 
            border-radius: 20px; 
        }
        
        .text-gradient { 
            background: linear-gradient(135deg, #6c63ff, #00d4ff); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
        }
        
        /* ===== HERO ===== */
        .hero { padding: 100px 0 60px; text-align: center; }
        .hero h1 { font-size: 3.5rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 20px; }
        .hero-profile { 
            width: 160px; height: 160px; border-radius: 50%; 
            border: 4px solid var(--primary); margin-bottom: 24px; 
            box-shadow: 0 0 40px rgba(108, 99, 255, 0.3); 
        }

        /* ===== BUTTONS ===== */
        .btn-primary {
            display: inline-block; background: var(--primary); padding: 14px 32px; 
            border-radius: 12px; color: #fff; text-decoration: none; font-weight: 600; 
            box-shadow: 0 10px 30px rgba(108, 99, 255, 0.4);
            transition: transform 0.3s ease;
        }
        .btn-primary:hover { transform: translateY(-3px); }

        /* ===== SKILLS SECTION ===== */
        .skills-grid { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-top: 40px; }
        .skill-card { padding: 24px; transition: 0.3s; }
        .skill-card:hover { border-color: var(--primary); transform: translateY(-5px); }
        .skill-item { margin-bottom: 16px; }
        .skill-item .header { display: flex; justify-content: space-between; font-size: 14px; font-weight: 500; }
        .skill-item .bar { height: 8px; background: var(--border); border-radius: 999px; margin-top: 8px; overflow: hidden; }
        .skill-item .bar .fill { height: 100%; background: linear-gradient(135deg, #6c63ff, #00d4ff); border-radius: 999px; }

        /* ===== PROJECT GRID ===== */
        .grid-3 { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); margin-top: 40px; }
        .project-card { 
            display: block; padding: 16px; text-decoration: none; color: inherit; 
            transition: 0.3s; background: var(--surface); border: 1px solid var(--border); border-radius: 20px;
        }
        .project-card:hover { transform: translateY(-6px); border-color: var(--primary); box-shadow: var(--shadow-luxe); }
        .project-card img { width: 100%; border-radius: 12px; height: auto; display: block; }

        /* ===== FOOTER ===== */
        footer { margin-top: 80px; padding: 30px 0; border-top: 1px solid var(--border); text-align: center; color: var(--text-muted); }

        @media (max-width: 768px) {
            .hero h1 { font-size: 2.5rem; }
        }
    </style>
