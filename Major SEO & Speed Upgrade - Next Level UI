    <style>
        /* ===== CSS VARIABLES (Premium Glassmorphism) ===== */
        :root {
            --radius: 1rem;
            --background: #0b0d17;
            --foreground: #e8ecf4;
            --card: #14172b;
            --primary: #6c63ff;
            --secondary: #2a2f4f;
            --muted-foreground: #8e94b0;
            --border: #2a2f4f;
            --surface: rgba(20, 23, 43, 0.7);
            --gradient-brand: linear-gradient(135deg, #6c63ff, #00d4ff);
            --shadow-luxe: 0 20px 60px rgba(108, 99, 255, 0.3);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Manrope', sans-serif; background: var(--background); color: var(--foreground); transition: 0.4s; line-height: 1.7; scroll-behavior: smooth; }
        h1, h2, h3 { font-family: 'Sora', sans-serif; letter-spacing: -0.02em; }
        .container { max-width: 1180px; width: 92vw; margin: 0 auto; }
        
        /* ===== PREMIUM COMPONENTS ===== */
        .glass { background: var(--surface); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius); }
        .text-gradient { background: var(--gradient-brand); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .shadow-luxe { box-shadow: var(--shadow-luxe); }
        .reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
        .reveal.in-view { opacity: 1; transform: translateY(0); }

        /* ===== NAVBAR ===== */
        nav { position: fixed; top: 0; width: 100%; z-index: 50; padding: 20px 0; transition: 0.4s; }
        nav.scrolled .nav-inner { background: var(--surface); backdrop-filter: blur(20px); border: 1px solid var(--border); box-shadow: var(--shadow-luxe); padding: 10px 20px; }
        .nav-inner { display: flex; justify-content: space-between; align-items: center; border-radius: 20px; transition: 0.4s; }
        .nav-links { display: none; gap: 6px; }
        @media (min-width: 1024px) { .nav-links { display: flex; } }
        .nav-links a { padding: 8px 18px; border-radius: 999px; font-size: 14px; font-weight: 500; color: var(--muted-foreground); text-decoration: none; transition: 0.3s; }
        .nav-links a:hover { background: rgba(255,255,255,0.05); color: var(--foreground); }
        .theme-btn, .menu-btn { background: transparent; border: 1px solid var(--border); border-radius: 12px; padding: 10px; cursor: pointer; color: var(--muted-foreground); transition: 0.3s; }
        .theme-btn:hover, .menu-btn:hover { color: var(--foreground); border-color: var(--primary); }
        .cv-btn { display: none; background: var(--gradient-brand); color: #fff; padding: 8px 18px; border-radius: 12px; text-decoration: none; font-weight: 600; box-shadow: 0 4px 15px rgba(108, 99, 255, 0.3); }
        @media (min-width: 1024px) { .cv-btn { display: inline-flex; } }

        /* ===== HERO (Next Level) ===== */
        .hero { padding: 160px 0 100px; position: relative; }
        .hero-grid { display: grid; gap: 40px; align-items: center; }
        @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.2fr 0.8fr; } }
        .hero h1 { font-size: 3.5rem; line-height: 1.1; margin: 24px 0; }
        @media (min-width: 768px) { .hero h1 { font-size: 4.5rem; } }
        .hero p { color: var(--muted-foreground); font-size: 1.2rem; max-width: 36rem; }
        .hero-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 40px; }
        @media (min-width: 640px) { .hero-stats { grid-template-columns: repeat(4, 1fr); } }
        .hero-stats div { text-align: center; padding: 16px; background: var(--surface); border-radius: 16px; border: 1px solid var(--border); }
        .hero-stats dt { font-size: 2.2rem; font-weight: 700; background: var(--gradient-brand); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        /* ===== PROJECTS ===== */
        .projects-grid { column-count: 1; column-gap: 24px; margin-top: 40px; }
        @media (min-width: 640px) { .projects-grid { column-count: 2; } }
        @media (min-width: 1024px) { .projects-grid { column-count: 3; } }
        .project-card { display: block; padding: 8px; border-radius: 24px; background: var(--surface); backdrop-filter: blur(20px); border: 1px solid var(--border); text-decoration: none; transition: 0.4s; color: inherit; }
        .project-card:hover { transform: translateY(-10px); box-shadow: var(--shadow-luxe); border-color: var(--primary); }
        .project-card img { width: 100%; height: auto; border-radius: 18px; display: block; }

        /* ===== TESTIMONIALS (New Section for Trust) ===== */
        .testimonial-card { padding: 32px; border-radius: 24px; background: var(--surface); border: 1px solid var(--border); transition: 0.4s; }
        .testimonial-card:hover { transform: translateY(-5px); border-color: var(--primary); }

        footer { border-top: 1px solid var(--border); padding: 40px 0 20px; margin-top: 60px; text-align: center; color: var(--muted-foreground); }
